{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@vendor/*": ["./src/vendor/*"],
      "@shared/*": ["./src/vendor/shared/*"],
      "node:crypto": ["./src/platform/nodeCrypto.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "android", "ios", "tests", "vitest.config.ts"]
}
