{
  "expo": {
    "name": "ClearChat",
    "slug": "clearchat-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clearchat",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0b0f",
    "ios": {
      "bundleIdentifier": "com.ezenere.clearchat",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O ClearChat usa o microfone só quando você toca no microfone (ditado) ou liga uma chamada de voz.",
        "NSFaceIDUsageDescription": "O ClearChat usa o Face ID para abrir seus dados neste aparelho.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.ezenere.clearchat",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#6a4be0"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0b0f",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "O ClearChat usa o Face ID para abrir seus dados neste aparelho.",
          "configureAndroidBackup": true
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "O ClearChat acessa suas fotos para anexar imagens às mensagens.",
          "cameraPermission": false,
          "microphonePermission": "O ClearChat usa o microfone só quando você toca no microfone (ditado) ou liga uma chamada de voz."
        }
      ],
      "expo-document-picker",
      [
        "expo-audio",
        {
          "microphonePermission": "O ClearChat usa o microfone só quando você toca no microfone (ditado) ou liga uma chamada de voz.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "./plugins/withReleaseSigning",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "c5c6641f-8015-4029-b9ae-7e3328f8dcba"
      }
    },
    "owner": "ezenere"
  }
}
