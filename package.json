{
  "name": "clearchat-mobile",
  "version": "0.1.0",
  "description": "ClearChat Mobile — cliente Android/iOS do protocolo de sync do ClearChat",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test-server": "scripts/test-server.sh",
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@shopify/flash-list": "2.3.2",
    "expo": "58.0.22",
    "expo-build-properties": "58.0.12",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-device": "58.0.5",
    "expo-file-system": "58.0.13",
    "expo-image": "58.0.18",
    "expo-linking": "58.0.15",
    "expo-router": "58.0.29",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "58.0.21",
    "expo-splash-screen": "58.0.12",
    "expo-sqlite": "58.0.15",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "fflate": "0.8.3",
    "marked": "18.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-url-polyfill": "4.0.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "hash-wasm": "4.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
