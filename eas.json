{
  "cli": {
    "version": ">= 27.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "credentialsSource": "local",
      "android": { "buildType": "app-bundle" }
    },
    "apk": {
      "environment": "preview",
      "credentialsSource": "local",
      "android": { "buildType": "apk" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
