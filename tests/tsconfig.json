{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@/*": ["../src/*"],
      "@vendor/*": ["../src/vendor/*"],
      "@shared/*": ["../src/vendor/shared/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "../vitest.config.ts",
    "../vitest.integration.config.ts",
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "../expo-env.d.ts"
  ],
  "exclude": ["../node_modules"]
}
